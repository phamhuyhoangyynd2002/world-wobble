# Chép thành .env rồi điền. Không commit .env.

# Giọng đọc (bắt buộc): Azure AI Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Tạm dùng Edge TTS khi kênh chưa kiếm tiền (chốt 16/11/2026). Xoá dòng này trước khi bật kiếm tiền.
CHO_PHEP_EDGE=1

# Kiểm chứng vòng 2 và tạo ảnh minh hoạ: Gemini API (Google AI Studio)
GEMINI_API_KEY=
# Tên model lấy từ: python3 .claude/skills/kiem-chung/scripts/gemini_kiem_chung.py --list-models
# Model có tìm kiếm web (Google Search grounding) cho kiểm chứng:
GEMINI_MODEL=
# Model tạo ảnh (ví dụ dòng "Nano Banana"); xem bảng giá ở docs/du-lieu-kenh-dai-2026-11-14/ghi-chu-agent/cong-cu-va-chi-phi.md
GEMINI_IMAGE_MODEL=

# Ảnh AI hạng phụ tạo nội bộ bằng ComfyUI trên máy (chốt 17/11/2026; .claude/skills/lay-tai-nguyen/scripts/tao_anh_noi_bo.py)
COMFYUI_DIR=D:/ComfyUI
COMFYUI_URL=http://127.0.0.1:8188
# Chỉ model có trong MODELS của tao_anh_noi_bo.py (đã kiểm giấy phép thương mại)
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
# Số ảnh hạng chính tối đa mỗi tập trước khi validate_script.py cảnh báo
ANH_CHINH_TOI_DA=6
