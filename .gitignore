node_modules/
.env
.DS_Store
__pycache__/

# Dữ liệu nặng của từng video (giữ lại brief, research, script, kiem-chung, timeline, báo cáo)
projects/*/assets/**/*.png
projects/*/assets/**/*.jpg
projects/*/assets/**/*.jpeg
projects/*/assets/**/*.webp
projects/*/audio/
projects/*/render/
projects/*/out/*.mp4
projects/*/out/frames/

# Bản đồ nền Natural Earth tải về (13 MB, tải lại được)
.cache/

# Ảnh chụp thử của HyperFrames
**/snapshots/

# Bản thử (ban-thu-*): video, khung hình, audio, node_modules
projects/*/ban-thu-*/**/out/*.mp4
projects/*/ban-thu-*/**/out/frames/
projects/*/ban-thu-*/**/audio/
projects/*/ban-thu-*/**/node_modules/

# Repo ngoài tải về để đọc mã (có .git riêng)
projects/*/ban-thu-*/**/repo-ngoai/
projects/*/ban-thu-*/**/music/
projects/*/ban-thu-*/**/sfx/
projects/*/ban-thu-*/**/fonts/
projects/*/ban-thu-*/**/_shared/
# Đoạn hoạt hình: lib/ và _chung/ do chuan_bi_doan.py chép lại từ templates/hoat-hinh/
projects/**/hoat-hinh/doan-*/lib/
projects/**/hoat-hinh/doan-*/_chung/
projects/**/hoat-hinh/out/*.mp4
projects/**/hoat-hinh/out/frames/
